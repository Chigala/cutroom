# Copy to .env (git-ignored) and fill in what you have. Everything here is optional: the app runs
# without any of it. In development the repo's .env is read; a packaged app reads the .env in its
# data folder, and keys can also be saved in Settings, where they're stored encrypted.

# Claude. Without it, the agent uses Claude Code (installed and signed in with your own Claude plan).
ANTHROPIC_API_KEY=

# Stock footage and photos (free keys): https://www.pexels.com/api/ and https://pixabay.com/api/docs/
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Reaction GIFs, stickers and memes: https://partner.klipy.com/
KLIPY_API_KEY=

# Sound effects (CC0 / CC BY): https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# Reuse an existing whisper.cpp install (a folder with its binary and models) instead of downloading one.
VEDIT_WHISPER_DIR=
