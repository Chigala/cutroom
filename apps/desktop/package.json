{
  "name": "@vedit/desktop",
  "productName": "Cutroom",
  "version": "0.1.0",
  "description": "A video editor built for an AI agent to edit with you",
  "homepage": "https://github.com/Chigala/cutroom",
  "desktopName": "cutroom.desktop",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs && jiti scripts/runtime-assets.mts",
    "dist": "pnpm run build && pnpm run tools && pnpm run runtime-deps && electron-builder --config electron-builder.yml",
    "dist:test": "pnpm run build && pnpm run tools && pnpm run runtime-deps && electron-builder --config electron-builder.yml --mac --arm64 -c.mac.identity=- -c.mac.hardenedRuntime=false",
    "dist:dir": "pnpm run build && pnpm run tools && pnpm run runtime-deps && electron-builder --config electron-builder.yml --dir",
    "runtime-deps": "node scripts/runtime-deps.mjs",
    "tools": "jiti scripts/bundle-tools.mts",
    "typecheck": "tsc --noEmit -p .",
    "build:fast": "node scripts/build.mjs --no-remotion",
    "score": "jiti scripts/score.mts",
    "bench": "node scripts/bench.mjs"
  },
  "//": "Everything is bundled into dist/, so the packaged app ships no node_modules: all deps are dev deps.",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vedit/agent": "workspace:*",
    "@vedit/bridge": "workspace:*",
    "@vedit/checks": "workspace:*",
    "@vedit/client": "workspace:*",
    "@vedit/instant": "workspace:*",
    "@vedit/media": "workspace:*",
    "@vedit/project": "workspace:*",
    "@vedit/render": "workspace:*",
    "electron": "44.5.1",
    "electron-builder": "^26.15.3",
    "jiti": "2.7.0",
    "vite": "^8.3.2",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@remotion/bundler": "4.0.532",
    "@remotion/install-whisper-cpp": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "gsap": "3.15.0",
    "lottie-web": "5.13.0",
    "three": "0.186.1"
  }
}
