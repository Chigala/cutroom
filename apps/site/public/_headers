# Cloudflare's static assets: hashed files never change, so they're kept for good; the demo's files keep a day.
# (The page itself isn't listed: it's checked every visit, so a new version shows up at once.)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/demo/*
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
